    <string name="app_name">DSH Desktop</string>
    <string name="setup_title">连接 dsh web</string>
    <string name="setup_hint">这个应用不启动 dsh，也不带运行时；它只承载你已经在电脑上跑起来的 dsh web。</string>
    <string name="setup_url_label">dsh web 地址</string>
